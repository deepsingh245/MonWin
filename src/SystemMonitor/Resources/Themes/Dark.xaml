<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="MonWin.Background" Color="#202020" Opacity="0.92" />
    <SolidColorBrush x:Key="MonWin.OverlayBackground" Color="#2C2C2C" Opacity="0.85" />
    <SolidColorBrush x:Key="MonWin.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MonWin.SubtleForeground" Color="#B0B0B0" />
    <SolidColorBrush x:Key="MonWin.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="MonWin.Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="MonWin.AccentFill" Color="#60CDFF" Opacity="0.15" />
    <SolidColorBrush x:Key="MonWin.HoverBackground" Color="#333333" />

</ResourceDictionary>
