<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="MonWin.Background" Color="#F3F3F3" Opacity="0.92" />
    <SolidColorBrush x:Key="MonWin.OverlayBackground" Color="#F9F9F9" Opacity="0.85" />
    <SolidColorBrush x:Key="MonWin.Foreground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MonWin.SubtleForeground" Color="#5C5C5C" />
    <SolidColorBrush x:Key="MonWin.Border" Color="#D9D9D9" />
    <SolidColorBrush x:Key="MonWin.Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="MonWin.AccentFill" Color="#0067C0" Opacity="0.12" />
    <SolidColorBrush x:Key="MonWin.HoverBackground" Color="#E5E5E5" />

</ResourceDictionary>
