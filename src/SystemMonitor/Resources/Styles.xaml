<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="MonWin.Font">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="MonWin.Window.Overlay" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="FontFamily" Value="{StaticResource MonWin.Font}" />
        <Setter Property="Topmost" Value="True" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <Style x:Key="MonWin.Border.Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource MonWin.OverlayBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MonWin.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonWin.Border.DetailedCard" TargetType="Border" BasedOn="{StaticResource MonWin.Border.Card}">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource MonWin.Background}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MonWin.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource MonWin.Font}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MonWin.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource MonWin.Font}" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonWin.Font}" />
    </Style>

    <Style x:Key="MonWin.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MonWin.Foreground}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="MonWin.Button" TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="{DynamicResource MonWin.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MonWin.Font}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonWin.Button.Secondary" TargetType="Button" BasedOn="{StaticResource MonWin.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MonWin.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MonWin.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
