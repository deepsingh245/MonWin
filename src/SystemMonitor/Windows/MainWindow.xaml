<Window x:Class="SystemMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemMonitor.Controls"
        xmlns:vm="clr-namespace:SystemMonitor.ViewModels"
        Style="{StaticResource MonWin.Window.Overlay}"
        x:Name="Root"
        Title="MonWin System Monitor">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Open Detailed View" Click="OnOpenDetailedClick" />
            <MenuItem Header="Show Compact View" Click="OnShowCompactClick" />
            <MenuItem Header="Settings" Click="OnOpenSettingsClick" />
            <MenuItem Header="Pause Monitoring" Command="{Binding TogglePauseCommand}" IsCheckable="True" IsChecked="{Binding IsPaused, Mode=OneWay}" />
            <MenuItem Header="Start with Windows" Command="{Binding ToggleStartWithWindowsCommand}" IsCheckable="True" IsChecked="{Binding Settings.StartWithWindows, Mode=OneWay}" />
            <MenuItem Header="About" Click="OnOpenAboutClick" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
    <Border x:Name="CardBorder"
            Style="{StaticResource MonWin.Border.Card}"
            PreviewMouseLeftButtonDown="OnCardPreviewMouseLeftButtonDown"
            MouseLeftButtonUp="OnCardLeftClick"
            MouseDown="OnCardMouseDown"
            ToolTipService.IsEnabled="{Binding Settings.ShowTooltip}">

        <Border.LayoutTransform>
            <ScaleTransform x:Name="CardScaleTransform"
                            ScaleX="{Binding Settings.OverlayScale, Mode=OneWay}"
                            ScaleY="{Binding Settings.OverlayScale, Mode=OneWay}" />
        </Border.LayoutTransform>

        <Border.ToolTip>
            <ToolTip Content="Left-click to open the detailed monitor. Right-click for settings. Drag to move; drag the corner grip to resize." />
        </Border.ToolTip>

        <Grid>
            <!-- Compact / Compact+Graph overlay row -->
            <StackPanel Orientation="Horizontal" x:Name="OverlayContent">
                <controls:MetricControl Label="CPU" ValueText="{Binding CpuValueText}"
                                         Values="{Binding CpuHistory}" IsCompact="True"
                                         ShowGraph="{Binding Settings.DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=CompactGraph}"
                                         Visibility="{Binding Settings.ShowCpu, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,10,0" />
                <controls:MetricControl Label="RAM" ValueText="{Binding RamValueText}"
                                         Values="{Binding MemoryHistory}" IsCompact="True"
                                         ShowGraph="{Binding Settings.DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=CompactGraph}"
                                         Visibility="{Binding Settings.ShowRam, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,10,0" />
                <controls:MetricControl Label="GPU" ValueText="{Binding GpuValueText}"
                                         Values="{Binding GpuHistory}" IsCompact="True"
                                         ShowGraph="{Binding Settings.DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=CompactGraph}"
                                         Visibility="{Binding Settings.ShowGpu, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Detailed presentation -->
            <StackPanel Orientation="Vertical" x:Name="DetailedContent" Visibility="Collapsed" MinWidth="260">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="System Monitor" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource MonWin.Foreground}" />
                    <Button Content="✕" DockPanel.Dock="Right" Width="24" Height="24"
                            Style="{StaticResource MonWin.Button.Secondary}"
                            Click="OnCloseDetailedClick" HorizontalAlignment="Right" />
                </DockPanel>

                <controls:MetricControl Label="CPU" ValueText="{Binding CpuValueText}"
                                         SecondaryText="{Binding CpuSecondaryText}"
                                         Values="{Binding CpuHistory}" IsCompact="False"
                                         Visibility="{Binding Settings.ShowCpu, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,0,14" />
                <TextBlock Text="{Binding ProcessorInfoText}" FontSize="10" Opacity="0.55"
                           Foreground="{DynamicResource MonWin.Foreground}" Margin="0,-10,0,14"
                           Visibility="{Binding Settings.ShowCpu, Converter={StaticResource BoolToVisibility}}" />

                <controls:MetricControl Label="RAM" ValueText="{Binding RamValueText}"
                                         SecondaryText="{Binding RamSecondaryText}"
                                         Values="{Binding MemoryHistory}" IsCompact="False"
                                         Visibility="{Binding Settings.ShowRam, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,0,14" />

                <controls:MetricControl Label="GPU" ValueText="{Binding GpuValueText}"
                                         SecondaryText="{Binding GpuSecondaryText}"
                                         Values="{Binding GpuHistory}" IsCompact="False"
                                         Visibility="{Binding Settings.ShowGpu, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding GpuName}" FontSize="10" Opacity="0.55"
                           Foreground="{DynamicResource MonWin.Foreground}" Margin="0,4,0,0"
                           Visibility="{Binding Settings.ShowGpu, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>

    <Thumb x:Name="ResizeThumb"
           Width="14" Height="14" Cursor="SizeNWSE"
           HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Margin="0,0,-3,-3"
           DragDelta="OnResizeThumbDragDelta"
           DragCompleted="OnResizeThumbDragCompleted"
           MouseLeftButtonDown="OnResizeThumbMouseLeftButtonDown"
           ToolTip="Drag to resize. Double-click to reset.">
        <Thumb.Style>
            <Style TargetType="Thumb">
                <Setter Property="Opacity" Value="0.25" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardBorder}" Value="True">
                        <Setter Property="Opacity" Value="0.9" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Thumb.Style>
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <Path Data="M 14,0 L 14,14 L 0,14 Z" Fill="{DynamicResource MonWin.Accent}" />
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
