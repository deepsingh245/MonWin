<Window x:Class="SystemMonitor.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MonWin.Window.Overlay}"
        WindowStartupLocation="CenterScreen"
        Title="About MonWin">

    <Border Style="{StaticResource MonWin.Border.DetailedCard}" Width="340">
        <StackPanel>
            <TextBlock Text="MonWin System Monitor" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource MonWin.Foreground}" />
            <TextBlock Text="{Binding Version, StringFormat=Version {0}}" FontSize="11" Opacity="0.6"
                       Foreground="{DynamicResource MonWin.Foreground}" Margin="0,2,0,12" />
            <TextBlock Text="{Binding PrivacyStatement}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource MonWin.Foreground}" />
            <TextBlock Text="Right-click the overlay (or the tray icon) for settings." FontSize="11" Opacity="0.6"
                       Foreground="{DynamicResource MonWin.Foreground}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <Button Content="Close" Style="{StaticResource MonWin.Button}" HorizontalAlignment="Right"
                    Margin="0,16,0,0" Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
