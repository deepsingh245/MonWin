<UserControl x:Class="SystemMonitor.Controls.MetricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SystemMonitor.Controls"
             x:Name="Root">
    <Grid>
        <!-- Compact / Compact+Graph: single horizontal row -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MonWin.Foreground}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding ValueText, ElementName=Root}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MonWin.Accent}"
                       VerticalAlignment="Center" MinWidth="30" />
            <controls:SparklineControl Values="{Binding Values, ElementName=Root}"
                                        Width="42" Height="16" Margin="4,0,0,0"
                                        LineBrush="{DynamicResource MonWin.Accent}"
                                        Visibility="{Binding ShowGraph, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Detailed: vertical block -->
        <StackPanel Orientation="Vertical">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.7"
                       Foreground="{DynamicResource MonWin.Foreground}" />
            <TextBlock Text="{Binding ValueText, ElementName=Root}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource MonWin.Foreground}" Margin="0,2,0,2" />
            <TextBlock Text="{Binding SecondaryText, ElementName=Root}"
                       FontSize="11" Opacity="0.65"
                       Foreground="{DynamicResource MonWin.Foreground}"
                       Visibility="{Binding SecondaryText, ElementName=Root, Converter={StaticResource StringNotEmptyToVisibility}}" />
            <controls:SparklineControl Values="{Binding Values, ElementName=Root}"
                                        Width="220" Height="36" Margin="0,6,0,0"
                                        LineBrush="{DynamicResource MonWin.Accent}"
                                        FillBrush="{DynamicResource MonWin.AccentFill}" />
        </StackPanel>
    </Grid>
</UserControl>
