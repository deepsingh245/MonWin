<Application x:Class="SystemMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SystemMonitor.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBoolean" />
            <converters:EnumEqualsConverter x:Key="EnumEquals" />
            <converters:NullableToUnavailableTextConverter x:Key="NullableToUnavailableText" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
