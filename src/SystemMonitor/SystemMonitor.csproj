<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>SystemMonitor</AssemblyName>
    <RootNamespace>SystemMonitor</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- WPF's binding/converter pipeline is culture-aware (e.g. Visibility bindings
         resolve CultureInfo internally) and throws under invariant globalization, so
         InvariantGlobalization is intentionally left off here despite the smaller
         publish size it would otherwise give. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Company>MonWin</Company>
    <Product>MonWin System Monitor</Product>
    <!-- DPI awareness is declared in app.manifest for WPF's benefit (per-monitor v2);
         WinForms is only used here for the tray icon (no WinForms UI is shown), so its
         own high-DPI API/property is intentionally not used alongside the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- UseWPF + UseWindowsForms both add implicit global usings for types (UserControl,
       Brush, Timer) that exist in both frameworks. We only need a handful of WinForms/
       GDI+ types (NotifyIcon, Icon, ContextMenuStrip) and always reference them fully
       qualified, so drop the WinForms/Drawing implicit usings to resolve the ambiguity
       in favor of WPF's types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
