<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MonWin.Linux.Views"
             x:Class="MonWin.Linux.Views.MetricControl"
             x:Name="Root">

    <UserControl.Styles>
        <!-- Normal state: accent for the compact value, foreground for the big detailed number.
             Warning/Critical (set by MetricControl.cs) swap in the amber/red brushes. -->
        <Style Selector="TextBlock.compactValue">
            <Setter Property="Foreground" Value="{DynamicResource MonWin.Accent}" />
        </Style>
        <Style Selector="TextBlock.detailedValue">
            <Setter Property="Foreground" Value="{DynamicResource MonWin.Foreground}" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource MonWin.Warning}" />
        </Style>
        <Style Selector="TextBlock.critical">
            <Setter Property="Foreground" Value="{DynamicResource MonWin.Critical}" />
        </Style>
        <Style Selector="local|SparklineControl">
            <Setter Property="LineBrush" Value="{DynamicResource MonWin.Accent}" />
        </Style>
        <Style Selector="local|SparklineControl.warning">
            <Setter Property="LineBrush" Value="{DynamicResource MonWin.Warning}" />
        </Style>
        <Style Selector="local|SparklineControl.critical">
            <Setter Property="LineBrush" Value="{DynamicResource MonWin.Critical}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Compact / Compact+Graph: single horizontal row -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    IsVisible="{Binding #Root.IsCompact}">
            <TextBlock Text="{Binding #Root.Label}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MonWin.Foreground}"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock x:Name="CompactValue" Classes="compactValue"
                       Text="{Binding #Root.ValueText}"
                       FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" MinWidth="{Binding #Root.ValueMinWidth}" />
            <local:SparklineControl x:Name="CompactGraph"
                                    Values="{Binding #Root.Values}"
                                    MaxValue="{Binding #Root.GraphMaxValue}"
                                    Width="42" Height="16" Margin="4,0,0,0"
                                    IsVisible="{Binding #Root.ShowGraph}" />
        </StackPanel>

        <!-- Detailed: vertical block -->
        <StackPanel Orientation="Vertical" IsVisible="{Binding !#Root.IsCompact}">
            <TextBlock Text="{Binding #Root.Label}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.7"
                       Foreground="{DynamicResource MonWin.Foreground}" />
            <TextBlock x:Name="DetailedValue" Classes="detailedValue"
                       Text="{Binding #Root.ValueText}"
                       FontSize="26" FontWeight="Bold" Margin="0,2,0,2" />
            <TextBlock Text="{Binding #Root.SecondaryText}"
                       FontSize="11" Opacity="0.65"
                       Foreground="{DynamicResource MonWin.Foreground}"
                       IsVisible="{Binding #Root.HasSecondaryText}" />
            <local:SparklineControl x:Name="DetailedGraph"
                                    Values="{Binding #Root.Values}"
                                    MaxValue="{Binding #Root.GraphMaxValue}"
                                    FillBrush="{DynamicResource MonWin.AccentFill}"
                                    Width="220" Height="36" Margin="0,6,0,0" />
        </StackPanel>
    </Panel>
</UserControl>
